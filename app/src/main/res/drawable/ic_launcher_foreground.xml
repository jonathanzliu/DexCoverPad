<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a touchpad outline with a tap point.
  Drawn on a 108x108 viewport; all art stays inside the 18..90 safe zone so no
  part of it is clipped by the launcher's mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Touchpad surface -->
    <path
        android:pathData="M32,28 L76,28 A8,8 0 0 1 84,36 L84,72 A8,8 0 0 1 76,80 L32,80 A8,8 0 0 1 24,72 L24,36 A8,8 0 0 1 32,28 Z"
        android:fillColor="#00000000"
        android:strokeColor="#3D7EFF"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round" />

    <!-- Tap point -->
    <path
        android:pathData="M54,54 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0"
        android:fillColor="#3D7EFF" />
</vector>
